# 选择第 n 个重要特征
top_feature <- shap_importance$feature[1]
print(top_feature)
# 从 shapviz 对象中提取数据
shap_vals <- sv$S[, top_feature]             # SHAP 值向量
feat_vals <- sv$X[[top_feature]]             # 该特征的原始值
target_vals <- data$targ                     # 目标值，注意与 X_explain 行顺序一致
# 构造绘图数据框
plot_df <- data.frame(
feature_value = feat_vals,
shap_value = shap_vals,
target = target_vals
)
# 手动绘制：用 target 作为 color 映射
p_dep_manual <- ggplot(
plot_df,
aes(
x = feature_value,
y = shap_value,
color = target
)
) +
geom_point(
size = 2,
shape = 21,
stroke = 0.35,
aes(fill = target)
) +
geom_smooth(
method = "loess",
se = FALSE,
color = "red",
linewidth = 1.2,
linetype = "dashed"
) +
scale_color_gradient(
low = "#FFCC33",
high = "#6600CC",
name = "Target value"
) +
scale_fill_gradient(
low = scales::alpha("#FFCC33", 0.75),
high = scales::alpha("#6600CC", 0.75),
name = "Target value"
) +
labs(
x = paste0(top_feature, " (Feature value)"),
y = paste0("SHAP value for ", top_feature),
color = "Target value",
fill = "Target value"
) +
theme_bw(
base_family = font_family,
base_size = dep_base_size
) +
theme(
text = element_text(
family = font_family
),
panel.grid.major = element_line(
color = "grey90",
linewidth = 0.3
),
panel.grid.minor = element_line(
color = "grey95",
linewidth = 0.2
),
axis.title.x = element_text(
size = dep_axis_title_size,
face = "bold",
family = font_family
),
axis.title.y = element_text(
size = dep_axis_title_size,
face = "bold",
family = font_family
),
axis.text.x = element_text(
size = dep_axis_text_size,
color = "black",
family = font_family
),
axis.text.y = element_text(
size = dep_axis_text_size,
color = "black",
family = font_family
),
legend.position = "right",
legend.title = element_text(
size = dep_legend_title_size,
face = "bold",
family = font_family
),
legend.text = element_text(
size = dep_legend_text_size,
color = "black",
family = font_family
),
plot.title = element_text(
size = 18,
face = "bold",
hjust = 0.5,
family = font_family
),
strip.text = element_text(
size = dep_axis_text_size,
face = "bold",
family = font_family
)
) +
guides(
color = guide_colorbar(
title = "Target value",
title.position = "top",
title.hjust = 0.5,
barwidth = unit(0.5, "cm"),
barheight = unit(10, "cm"),
ticks = TRUE,
ticks.colour = "black",
label.position = "right"
),
fill = "none"
)
